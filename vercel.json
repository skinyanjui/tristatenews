{
  "functions": {
    "api/news.js": {
      "maxDuration": 30,
      "includeFiles": "{data/pages/index.html,data/pages/404.html}"
    },
    "api/alerts.js": {
      "maxDuration": 20
    },
    "api/newsletter.js": {
      "maxDuration": 60
    },
    "api/inbox.js": {
      "includeFiles": "data/pages/**"
    }
  },
  "redirects": [
    {
      "source": "/:old(news|all|liked|police-courts|police|courts)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:old(news|all|liked|police-courts|police|courts)/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:tab(institutions|events|obituaries|jobs|deals|classifieds)/",
      "destination": "/:tab",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/legal.html",
      "destination": "/legal",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/refresh",
      "destination": "/api/news?__route=refresh"
    },
    {
      "source": "/api/checkout",
      "destination": "/api/listings?__route=checkout"
    },
    {
      "source": "/api/catalog",
      "destination": "/api/listings?__route=catalog"
    },
    {
      "source": "/api/flowers",
      "destination": "/api/listings?__route=flowers"
    },
    {
      "source": "/api/orders",
      "destination": "/api/listings?__route=orders"
    },
    {
      "source": "/api/subscribe",
      "destination": "/api/unsubscribe?__route=subscribe"
    },
    {
      "source": "/api/submit",
      "destination": "/api/inbox?__route=submit"
    },
    {
      "source": "/api/advertise",
      "destination": "/api/inbox?__route=advertise"
    },
    {
      "source": "/api/creative",
      "destination": "/api/inbox?__route=creative"
    },
    {
      "source": "/api/campaigns",
      "destination": "/api/inbox?__route=campaigns"
    },
    {
      "source": "/api/packages",
      "destination": "/api/inbox?__route=packages"
    },
    {
      "source": "/api/adstats",
      "destination": "/api/inbox?__route=adstats"
    },
    {
      "source": "/api/counties",
      "destination": "/api/news?__route=counties"
    },
    {
      "source": "/api/regions",
      "destination": "/api/news?__route=regions"
    },
    {
      "source": "/api/locations",
      "destination": "/api/news?__route=locations"
    },
    {
      "source": "/api/coverage",
      "destination": "/api/news?__route=coverage"
    },
    {
      "source": "/newsletter",
      "destination": "/newsletter.html"
    },
    {
      "source": "/advertise",
      "destination": "/api/inbox?__route=adpage"
    },
    {
      "source": "/news/:state/:county",
      "destination": "/api/news?__route=geopage&p=/news/:state/:county"
    },
    {
      "source": "/news/:state",
      "destination": "/api/news?__route=geopage&p=/news/:state"
    },
    {
      "source": "/sitemap-regions.xml",
      "destination": "/api/news?__route=geopage&sitemap=1"
    },
    {
      "source": "/",
      "destination": "/api/news?__route=tabpage&p=/"
    },
    {
      "source": "/:tab(institutions|events|obituaries|jobs|deals|classifieds)",
      "destination": "/api/news?__route=tabpage&p=/:tab"
    },
    {
      "source": "/legal",
      "destination": "/legal.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/accessibility",
      "destination": "/accessibility.html"
    },
    {
      "source": "/advertising",
      "destination": "/advertising.html"
    },
    {
      "source": "/copyright",
      "destination": "/copyright.html"
    },
    {
      "source": "/corrections",
      "destination": "/corrections.html"
    },
    {
      "source": "/order",
      "destination": "/order.html"
    },
    {
      "source": "/creative",
      "destination": "/creative.html"
    },
    {
      "source": "/unsubscribe",
      "destination": "/unsubscribe.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/inbox?__route=notfound&api=1"
    },
    {
      "source": "/:path*",
      "destination": "/api/inbox?__route=notfound"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com https://api.weather.gov; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/(favicon.svg|icon-512.png|og.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(breaking.js|routes.js|featured.js|adslots.js|adsizes.js|flowers.js|sponsors.json|manifest.webmanifest|legal.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
