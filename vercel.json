{
  "functions": {
    "api/news.js": {
      "maxDuration": 30
    },
    "api/alerts.js": {
      "maxDuration": 20
    },
    "api/newsletter.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:tab(news|police-courts|institutions|events|obituaries|jobs|deals|classifieds|liked)/",
      "destination": "/:tab",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/refresh",
      "destination": "/api/news?__route=refresh"
    },
    {
      "source": "/api/checkout",
      "destination": "/api/listings?__route=checkout"
    },
    {
      "source": "/api/catalog",
      "destination": "/api/listings?__route=catalog"
    },
    {
      "source": "/api/orders",
      "destination": "/api/listings?__route=orders"
    },
    {
      "source": "/api/subscribe",
      "destination": "/api/unsubscribe?__route=subscribe"
    },
    {
      "source": "/api/submit",
      "destination": "/api/inbox?__route=submit"
    },
    {
      "source": "/api/advertise",
      "destination": "/api/inbox?__route=advertise"
    },
    {
      "source": "/api/creative",
      "destination": "/api/inbox?__route=creative"
    },
    {
      "source": "/api/counties",
      "destination": "/api/news?__route=counties"
    },
    {
      "source": "/api/regions",
      "destination": "/api/news?__route=regions"
    },
    {
      "source": "/:tab(news|police-courts|institutions|events|obituaries|jobs|deals|classifieds|liked)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.google.com https://*.doubleclick.net https://adservice.google.com https://www.googletagservices.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com https://api.weather.gov https://*.google.com https://*.googlesyndication.com https://*.doubleclick.net; frame-src https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/(favicon.svg|icon-512.png|og.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
